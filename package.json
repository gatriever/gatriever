{
  "name": "gatriever-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check:changelog": "node .github/scripts/check-changelog.mjs",
    "sync:versions": "node .github/scripts/sync-version.mjs",
    "dev:bot": "pnpm --filter @gatriever/telegram-bot dev",
    "dev:api": "pnpm --filter @gatriever/api-server dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
