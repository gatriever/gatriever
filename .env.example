# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Secret Key for encrypting user GA credentials (32-byte string or random hash)
ENCRYPTION_SECRET=your_32_character_encryption_secret_here

# Storage Adapter to use: "memory", "file", or "firestore"
STORAGE_ADAPTER=file

# Optional: Path for file storage adapter JSON file
FILE_STORAGE_PATH=./data/users.json

# Default/Fallback GA4 Configuration (for single-user local mode)
DEFAULT_GA_CREDENTIALS_PATH=/path/to/service-account.json
DEFAULT_GA_PROPERTY_ID=548543981
