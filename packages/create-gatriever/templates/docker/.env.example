# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 32-character secret key for credential encryption
ENCRYPTION_SECRET=your_32_character_secret_key_here!

# Google Analytics Service Account JSON Credentials
GA_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# API Server Port (if api feature enabled)
PORT=3000
